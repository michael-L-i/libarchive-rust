#!/usr/bin/env bash
# Build the Rust port and its front-ends, and relink upstream's test program and C front-ends against it.
# Usage: scripts/build-port [--release]
# Outputs under build/port/: bin/{libarchive_test,bsdtar,bsdcpio,bsdcat,bsdunzip}, c-bin/ (upstream's C
# front-ends relinked against ours, for reference), skipped_tests.c, build.log. bin/ holds the Rust
# front-end where one is ported (RUST_TOOLS) and the relinked C one otherwise.
# bsdtar_test, bsdcpio_test, bsdcat_test and bsdunzip_test are NOT relinked: they link no libarchive
# (only their own objects); they drive a tool binary given with -p, so point them at build/port/bin/<tool>.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ora="$root/build/oracle"
out="$root/build/port"
log="$out/build.log"
profile=debug; rel=""
[ "${1:-}" = "--release" ] && { profile=release; rel=--release; }
tdir="${CARGO_TARGET_DIR:-$root/target}/$profile"
mkdir -p "$out/bin" "$out/c-bin"; : > "$log"
RUST_TOOLS=(bsdcat bsdcpio bsdunzip)

case "$(uname)" in
  Darwin) ext=dylib
          pub_syms() { nm -gU "$1" | awk '{print $3}' | sed 's/^_//'; }
          und_syms() { nm -u "$1" | awk '{print $NF}' | sed 's/^_//'; } ;;
  *)      ext=so
          pub_syms() { nm -D --defined-only "$1" | awk '{print $3}'; }
          und_syms() { nm -u "$1" | awk '{print $NF}'; } ;;
esac

# 1. Build the crate. The rustc note lists the system libs the staticlib needs; it is only
# printed when rustc runs, so cache it and fall back to the cache when cargo replays nothing.
cd "$root"
build() { cargo rustc $rel -p libarchive-capi --lib -- --print native-static-libs >>"$log" 2>&1 || { tail -30 "$log" >&2; exit 1; }; }
native_line() { grep -o 'native-static-libs: .*' "$log" | tail -1 | sed 's/^native-static-libs: //' || true; }
cache="$out/native-libs.$profile"
build
native=$(native_line)
if [ -z "$native" ] && [ -s "$cache" ]; then native=$(cat "$cache"); fi
if [ -z "$native" ]; then touch capi/src/lib.rs; build; native=$(native_line); fi
echo "$native" > "$cache"
read -ra native <<<"$native"
ours="$tdir/libarchive.a"
echo "built crate ($profile)"

# 2. ABI check: every public symbol of upstream's dylib must exist in ours.
pub_syms "$ora/libarchive/libarchive.$ext" | grep '^archive_' | sort -u > "$out/oracle.syms"
pub_syms "$tdir/libarchive.$ext" | sort -u > "$out/port.syms"
missing=$(comm -23 "$out/oracle.syms" "$out/port.syms")
if [ -n "$missing" ]; then echo "missing public symbols:" >&2; echo "$missing" >&2; exit 1; fi
echo "symbol check OK ($(wc -l < "$out/oracle.syms" | tr -d ' ') public symbols)"

# 3. libarchive_test: drop objects needing internals we don't export; stub their tests as skips.
tbld="$ora/libarchive/test"; tsrc="$root/upstream/libarchive/libarchive/test"
objdir=CMakeFiles/libarchive_test.dir
read -ra words <<<"$(cat "$tbld/$objdir/link.txt")"
excluded=()
for w in "${words[@]}"; do
  [[ $w == $objdir/test_*.c.o ]] || continue
  need=$(und_syms "$tbld/$w" | grep -E '^(__)?archive_' | sort -u | comm -23 - "$out/port.syms" || true)
  if [ -n "$need" ]; then excluded+=("$w"); fi
done
skip="$out/skipped_tests.c"
{ echo '#include "test.h"'
  for w in ${excluded[@]+"${excluded[@]}"}; do
    grep -oE '^DEFINE_TEST\([A-Za-z0-9_]+\)' "$tsrc/$(basename "$w" .o)" |
      sed -E 's/(DEFINE_TEST\(.*\))/\1\n{\n\tskipping("uses libarchive internals; covered by Rust tests");\n}\n/'
  done; } > "$skip"
nskip=$(grep -c '^DEFINE_TEST' "$skip" || true)
# Reuse the exact flags upstream compiled the test sources with.
cc_cmd=$(python3 -I -c 'import json, sys
print(next(e["command"] for e in json.load(open(sys.argv[1])) if e["file"].endswith("/libarchive/test/test_entry.c")))' \
  "$ora/compile_commands.json" | sed -E 's/ -o [^ ]+ -c [^ ]+$//')
read -ra cc <<<"$cc_cmd"
(cd "$tbld" && "${cc[@]}" -o "$out/skipped_tests.o" -c "$skip") >>"$log" 2>&1

# Upstream's link lines name the C codec libraries its libarchive.a needs. Ours needs none of
# them, so let the linker drop every shared library nothing references: each one loaded costs
# process startup time. Linux needs --as-needed ahead of the libraries it applies to.
case "$(uname)" in
  Darwin) as_needed=-Wl,-dead_strip_dylibs ;;
  *)      as_needed=-Wl,--as-needed ;;
esac

# relink <CMakeFiles/x.dir with link.txt; links run from two levels up> <output>: swap oracle libarchive.a for ours, redirect -o, drop excluded objects.
relink() {
  local dir=$1 output=$2 args=() prev= w ws
  read -ra ws <<<"$(cat "$dir/link.txt")"
  args+=("${ws[0]}" "$as_needed"); ws=("${ws[@]:1}")
  for w in "${ws[@]}"; do
    if [ "$prev" = -o ]; then w=$output
    elif [[ $w == *libarchive.a ]]; then args+=("$ours" "${native[@]}"); prev=$w; continue
    elif [[ " ${excluded[*]-} " == *" $w "* ]]; then prev=$w; continue
    fi
    args+=("$w"); prev=$w
  done
  if [ "$(basename "$output")" = libarchive_test ]; then args+=("$out/skipped_tests.o"); fi
  # Extra linker inputs, e.g. scripts/build-pgo's profiler runtime.
  read -ra extra <<<"${PORT_LDFLAGS-}"; args+=(${extra[@]+"${extra[@]}"})
  (cd "$dir/../.." && "${args[@]}") >>"$log" 2>&1 || { tail -20 "$log" >&2; exit 1; }
}
relink "$tbld/$objdir" "$out/bin/libarchive_test"

# 4. Front-end tools: upstream's C ones relinked (their link lines also carry upstream's
# libarchive_fe objects), and the Rust ones, which must contain no C: nothing they are built from
# may compile C (variadic.c is libarchive-capi's).
for t in tar cpio cat unzip; do relink "$ora/$t/CMakeFiles/bsd$t.dir" "$out/c-bin/bsd$t"; done
tools=$(printf -- '-p %s ' "${RUST_TOOLS[@]}")
c_deps=$(cargo tree $tools -e normal,build --prefix none | grep -E '^(cc|cmake|libarchive-capi) ' | sort -u || true)
if [ -n "$c_deps" ]; then echo "the Rust front-ends must contain no C, but they build with:" >&2; echo "$c_deps" >&2; exit 1; fi
cargo build $rel $tools >>"$log" 2>&1 || { tail -30 "$log" >&2; exit 1; }
for t in tar cpio cat unzip; do
  if [[ " ${RUST_TOOLS[*]} " == *" bsd$t "* ]]; then cp "$tdir/bsd$t" "$out/bin/"
  else cp "$out/c-bin/bsd$t" "$out/bin/"; fi
done

echo "${#excluded[@]} test files turned into skips ($nskip tests)"
echo "binaries: $out/bin/{libarchive_test,bsdtar,bsdcpio,bsdcat,bsdunzip} (Rust: ${RUST_TOOLS[*]}); C reference tools: $out/c-bin"
