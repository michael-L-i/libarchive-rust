#!/usr/bin/env bash
# Build the Rust port and relink upstream's test program and front-end tools against it.
# Usage: scripts/build-port [--release]
# Outputs under build/port/: bin/{libarchive_test,bsdtar,bsdcpio,bsdcat,bsdunzip}, skipped_tests.c, build.log.
# bsdtar_test, bsdcpio_test, bsdcat_test and bsdunzip_test are NOT relinked: they link no libarchive
# (only their own objects); they drive a tool binary given with -p, so point them at build/port/bin/<tool>.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ora="$root/build/oracle"
out="$root/build/port"
log="$out/build.log"
profile=debug; rel=""
[ "${1:-}" = "--release" ] && { profile=release; rel=--release; }
tdir="${CARGO_TARGET_DIR:-$root/target}/$profile"
mkdir -p "$out/bin"; : > "$log"

case "$(uname)" in
  Darwin) ext=dylib
          pub_syms() { nm -gU "$1" | awk '{print $3}' | sed 's/^_//'; }
          und_syms() { nm -u "$1" | awk '{print $NF}' | sed 's/^_//'; } ;;
  *)      ext=so
          pub_syms() { nm -D --defined-only "$1" | awk '{print $3}'; }
          und_syms() { nm -u "$1" | awk '{print $NF}'; } ;;
esac

# 1. Build the crate. The rustc note lists the system libs the staticlib needs; it is only
# printed when rustc runs, so cache it and fall back to the cache when cargo replays nothing.
cd "$root"
build() { cargo rustc $rel --lib -- --print native-static-libs >>"$log" 2>&1 || { tail -30 "$log" >&2; exit 1; }; }
native_line() { grep -o 'native-static-libs: .*' "$log" | tail -1 | sed 's/^native-static-libs: //' || true; }
cache="$out/native-libs.$profile"
build
native=$(native_line)
if [ -z "$native" ] && [ -s "$cache" ]; then native=$(cat "$cache"); fi
if [ -z "$native" ]; then touch src/lib.rs; build; native=$(native_line); fi
echo "$native" > "$cache"
read -ra native <<<"$native"
ours="$tdir/libarchive.a"
echo "built crate ($profile)"

# 2. ABI check: every public symbol of upstream's dylib must exist in ours.
pub_syms "$ora/libarchive/libarchive.$ext" | grep '^archive_' | sort -u > "$out/oracle.syms"
pub_syms "$tdir/libarchive.$ext" | sort -u > "$out/port.syms"
missing=$(comm -23 "$out/oracle.syms" "$out/port.syms")
if [ -n "$missing" ]; then echo "missing public symbols:" >&2; echo "$missing" >&2; exit 1; fi
echo "symbol check OK ($(wc -l < "$out/oracle.syms" | tr -d ' ') public symbols)"

# 3. libarchive_test: drop objects needing internals we don't export; stub their tests as skips.
tbld="$ora/libarchive/test"; tsrc="$root/upstream/libarchive/libarchive/test"
objdir=CMakeFiles/libarchive_test.dir
read -ra words <<<"$(cat "$tbld/$objdir/link.txt")"
excluded=()
for w in "${words[@]}"; do
  [[ $w == $objdir/test_*.c.o ]] || continue
  need=$(und_syms "$tbld/$w" | grep -E '^(__)?archive_' | sort -u | comm -23 - "$out/port.syms" || true)
  if [ -n "$need" ]; then excluded+=("$w"); fi
done
skip="$out/skipped_tests.c"
{ echo '#include "test.h"'
  for w in ${excluded[@]+"${excluded[@]}"}; do
    grep -oE '^DEFINE_TEST\([A-Za-z0-9_]+\)' "$tsrc/$(basename "$w" .o)" |
      sed -E 's/(DEFINE_TEST\(.*\))/\1\n{\n\tskipping("uses libarchive internals; covered by Rust tests");\n}\n/'
  done; } > "$skip"
nskip=$(grep -c '^DEFINE_TEST' "$skip" || true)
# Reuse the exact flags upstream compiled the test sources with.
cc_cmd=$(python3 -I -c 'import json, sys
print(next(e["command"] for e in json.load(open(sys.argv[1])) if e["file"].endswith("/libarchive/test/test_entry.c")))' \
  "$ora/compile_commands.json" | sed -E 's/ -o [^ ]+ -c [^ ]+$//')
read -ra cc <<<"$cc_cmd"
(cd "$tbld" && "${cc[@]}" -o "$out/skipped_tests.o" -c "$skip") >>"$log" 2>&1

# relink <CMakeFiles/x.dir with link.txt; links run from two levels up> <name>: swap oracle libarchive.a for ours, redirect -o, drop excluded objects.
relink() {
  local dir=$1 name=$2 args=() prev= w ws
  read -ra ws <<<"$(cat "$dir/link.txt")"
  for w in "${ws[@]}"; do
    if [ "$prev" = -o ]; then w="$out/bin/$name"
    elif [[ $w == *libarchive.a ]]; then args+=("$ours" "${native[@]}"); prev=$w; continue
    elif [[ " ${excluded[*]-} " == *" $w "* ]]; then prev=$w; continue
    fi
    args+=("$w"); prev=$w
  done
  if [ "$name" = libarchive_test ]; then args+=("$out/skipped_tests.o"); fi
  (cd "$dir/../.." && "${args[@]}") >>"$log" 2>&1 || { tail -20 "$log" >&2; exit 1; }
}
relink "$tbld/$objdir" libarchive_test

# 4. Front-end tools (their link lines also carry upstream's libarchive_fe objects).
relink "$ora/tar/CMakeFiles/bsdtar.dir" bsdtar
relink "$ora/cpio/CMakeFiles/bsdcpio.dir" bsdcpio
relink "$ora/cat/CMakeFiles/bsdcat.dir" bsdcat
relink "$ora/unzip/CMakeFiles/bsdunzip.dir" bsdunzip

echo "${#excluded[@]} test files turned into skips ($nskip tests)"
echo "binaries: $out/bin/{libarchive_test,bsdtar,bsdcpio,bsdcat,bsdunzip}"
