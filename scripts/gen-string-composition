#!/usr/bin/env python3
"""Generate src/archive_string_composition.rs from upstream's
archive_string_composition.h, keeping every table entry exactly.

usage: scripts/gen-string-composition PATH/TO/archive_string_composition.h
"""
import re
import sys
from pathlib import Path

src = Path(sys.argv[1]).read_text()
header = src[: src.index("*/") + 2]


def body(name):
    m = re.search(r"\b" + name + r"\[[^\]]*\](?:\[16\])?\s*=\s*\{(.*?)\n\};", src, re.S)
    if not m:
        m = re.search(r"\b" + name + r"\[\]\s*=\s*\{(.*?)\};", src, re.S)
    return m.group(1)


def triples(name):
    return re.findall(
        r"\{\s*0x([0-9A-Fa-f]+)\s*,\s*0x([0-9A-Fa-f]+)\s*,\s*0x([0-9A-Fa-f]+)\s*\}",
        body(name),
    )


def flat(name):
    m = re.search(r"\b" + name + r"\[[^\]]*\]\s*=\s*\{(.*?)\};", src, re.S)
    text = re.sub(r"/\*.*?\*/", "", m.group(1), flags=re.S)
    return [int(x) for x in re.findall(r"\d+", text)]


def rows(name):
    out = []
    for m in re.finditer(r"(/\*.*?\*/)?\s*\{([^}]*)\}", body(name), re.S):
        vals = [int(x) for x in re.findall(r"\d+", m.group(2))]
        assert len(vals) == 16, (name, vals)
        out.append((m.group(1), vals))
    return out


def fmt_rows(rs):
    lines = []
    for comment, vals in rs:
        if comment:
            lines.append("    // " + comment[2:-2].strip())
        lines.append("    [" + ", ".join(str(v) for v in vals) + "],")
    return "\n".join(lines)


def fmt_triples(name):
    ts = triples(name)
    return len(ts), "\n".join(f"    (0x{a}, 0x{b}, 0x{c})," for a, b, c in ts)


comp_n, comp = fmt_triples("u_composition_table")
dec_n, dec = fmt_triples("u_decomposition_table")
blocks = flat("u_decomposable_blocks")
ccc_index = flat("ccc_index")
cv, ci = rows("ccc_val"), rows("ccc_val_index")
assert len(blocks) == 0x1D2 + 1 and len(ccc_index) == 0x1D2 + 1

out = f"""{header}

// Ported from libarchive/archive_string_composition.h.
// Generated by scripts/gen-string-composition; do not edit by hand.

/// `(cp1, cp2, nfc)`, sorted by `(cp1, cp2)`.
pub(crate) static U_COMPOSITION_TABLE: [(u32, u32, u32); {comp_n}] = [
{comp}
];

pub(crate) static U_DECOMPOSABLE_BLOCKS: [u8; 0x1D2 + 1] = [
"""
for i in range(0, len(blocks), 32):
    out += "    " + ", ".join(str(v) for v in blocks[i : i + 32]) + ",\n"
out += f"""];

/// The table of the value of Canonical Combining Class.
pub(crate) static CCC_VAL: [[u8; 16]; {len(cv)}] = [
{fmt_rows(cv)}
];

/// The index table to `CCC_VAL`.
pub(crate) static CCC_VAL_INDEX: [[u8; 16]; {len(ci)}] = [
{fmt_rows(ci)}
];

/// The index table to `CCC_VAL_INDEX`.
pub(crate) static CCC_INDEX: [u8; 0x1D2 + 1] = [
"""
for i in range(0, len(ccc_index), 24):
    out += "    " + ", ".join(str(v) for v in ccc_index[i : i + 24]) + ",\n"
out += f"""];

/// `(nfc, cp1, cp2)`, sorted by `nfc`.
pub(crate) static U_DECOMPOSITION_TABLE: [(u32, u32, u32); {dec_n}] = [
{dec}
];
"""
target = Path(__file__).resolve().parent.parent / "src" / "archive_string_composition.rs"
target.write_text(out)
