#!/usr/bin/env python3
"""Verify zisofs writer regressions using an independently built upstream reader.

Usage: scripts/test-iso-zisofs --library target/release --reader build/oracle/bin/bsdtar
Only test code uses C, to control public-API data chunk boundaries.
"""
import argparse
import os
from pathlib import Path
import random
import subprocess
import sys
import tempfile
import zlib


def encoded(data):
    blocks = [data[i:i + 32768] for i in range(0, len(data), 32768)]
    body = bytearray()
    at = 16 + 4 * (len(blocks) + 1)
    pointers = [at]
    for block in blocks:
        if any(block):
            body.extend(zlib.compress(block))
        pointers.append(at + len(body))
    return (bytes.fromhex("37e45396c9dbd607") + len(data).to_bytes(4, "little")
            + bytes([4, 15, 0, 0])
            + b"".join(p.to_bytes(4, "little") for p in pointers) + body)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--library", required=True, type=Path)
    parser.add_argument("--reader", required=True, type=Path)
    args = parser.parse_args()
    library, reader = args.library.resolve(), args.reader.resolve()
    root = Path(__file__).resolve().parent.parent
    rng = random.Random(9660)
    random_data = rng.randbytes(300001)
    boot_data = rng.randbytes(70000)
    cases = [
        ("incompressible-blocks", random_data[:131072], random_data[:131072], 65536, False),
        ("buffered-tail", random_data, random_data, 65536, False),
        ("split-zero-block", bytes(32768) + random_data[:32768], bytes(32768) + random_data[:32768], 1000, False),
        ("precompressed-whole", encoded(boot_data), boot_data, 65536, False),
        ("precompressed-split", encoded(boot_data), boot_data, 16, False),
        ("boot-random", encoded(boot_data), boot_data, 65536, True),
        ("boot-compressible", encoded(b"x" * 70000), b"x" * 70000, 65536, True),
        ("boot-holes", encoded(bytes(70000)), bytes(70000), 65536, True),
    ]
    failed = 0
    with tempfile.TemporaryDirectory(prefix="iso-zisofs-") as directory:
        directory = Path(directory)
        driver = directory / "write-iso"
        subprocess.run([os.environ.get("CC", "cc"), "-O1", "-Wall", "-Wextra", "-Werror",
                        "-I", str(root / "upstream/libarchive/libarchive"), str(root / "tests/iso9660-zisofs.c"),
                        "-L", str(library), "-larchive", "-Wl,-rpath," + str(library),
                        "-o", str(driver)], check=True)
        for name, original, expected, chunk, boot in cases:
            source, image, extraction = directory / (name + ".bin"), directory / (name + ".iso"), directory / name
            source.write_bytes(original)
            extraction.mkdir()
            path = "boot.img" if boot else "f"
            options = "iso9660:zisofs" + (",boot=boot.img" if boot else "")
            write = subprocess.run([str(driver), str(image), options, str(source), str(chunk), path], capture_output=True)
            extract = subprocess.run([str(reader), "-xf", str(image), "-C", str(extraction)], capture_output=True)
            output = extraction / path
            same = write.returncode == 0 and extract.returncode == 0 and output.is_file() and output.read_bytes() == expected
            print(("PASS " if same else "FAIL ") + name)
            if not same:
                failed += 1
                sys.stderr.write((write.stderr + extract.stderr).decode(errors="replace"))
    print(f"{len(cases) - failed}/{len(cases)} zisofs regressions passed")
    return bool(failed)


if __name__ == "__main__":
    sys.exit(main())
